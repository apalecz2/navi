# Copy to .env and fill in. .env is gitignored; no real value belongs in this
# file or anywhere else in the repository (D9).

# --- required now ---

# IANA zone the scheduling machinery resolves against. No default, in the
# compose file or in the code.
DEFAULT_TZ=America/Toronto

# debug | info | warn | error
LOG_LEVEL=info

# Grafana admin password. Same rule as the application's own secrets: nothing
# that authorizes gets a default.
GRAFANA_ADMIN_PASSWORD=

# Which adapter delivers reminders. "logging" writes them to the log and sends
# nothing, which is right for development and wrong in a container — the service
# warns every boot when it is in force. An unknown name is a boot failure rather
# than a silent fallback, because a container that ticks, claims rows, reports
# healthy, and never reaches a phone is the worst failure this system has.
#
# "telegram" delivers to a real device. Requires TELEGRAM_BOT_TOKEN and
# ALLOWED_SENDER_ID below, both of which the process refuses to boot without
# once this names them.
NOTIFY_TRANSPORT=logging

# Required only when NOTIFY_TRANSPORT=telegram; unset (or empty) then is a
# boot failure naming the missing variable, the same way NOTIFY_TRANSPORT
# itself is validated. Not required for the "logging" default, so `go run`
# with no bot still works.
#
# Token from @BotFather. ALLOWED_SENDER_ID is the numeric chat id this bot
# sends reminders to — get it from the chat with the bot once it exists (D8
# will also read it as the inbound allowlist once P1 wires conversation; a
# single-user system has one chat id for both directions).
TELEGRAM_BOT_TOKEN=
ALLOWED_SENDER_ID=

# --- optional ---

# Writable directory on local disk holding the SQLite file, its WAL, and any
# secret generated on first run. Defaults to /data, which is what the compose
# volume mounts. Must not be an NFS or SMB mount: SQLite locking is unreliable
# there and a corrupted database is worse than any convenience gained (D3).
# DATA_DIR=/data

# Where the SQLite file lives. Defaults to navi.db under DATA_DIR, which is
# almost always what you want — set this only to put the database somewhere the
# rest of the data directory is not.
# DATABASE_PATH=/data/navi.db

# Directory holding the read-only configuration files: defaults.yaml now,
# persona.md from P5. Defaults to /config, which is where the compose file
# mounts ./config and where the image carries its own copies. Set it to ./config
# when running outside a container:
#
#   CONFIG_DIR=./config DEFAULT_TZ=America/Toronto DATA_DIR=./data go run ./cmd/navi
#
# CONFIG_DIR=/config

# --- parsed, not yet consumed ---
# Listed so the shape is visible. Each becomes required in the session that adds
# the component reading it.

# CHAT_TRANSPORT=telegram
# TELEGRAM_WEBHOOK_SECRET=
# LITESTREAM_REPLICA_URL=s3://bucket/navi
