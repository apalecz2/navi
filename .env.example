# Copy to .env and fill in. .env is gitignored; no real value belongs in this
# file or anywhere else in the repository (D9).

# --- required now ---

# IANA zone the scheduling machinery resolves against. No default, in the
# compose file or in the code.
DEFAULT_TZ=America/Toronto

# debug | info | warn | error
LOG_LEVEL=info

# Grafana admin password. Same rule as the application's own secrets: nothing
# that authorizes gets a default.
GRAFANA_ADMIN_PASSWORD=

# Which adapter delivers reminders. "logging" writes them to the log and sends
# nothing, which is right for development and wrong in a container — the service
# warns every boot when it is in force. An unknown name is a boot failure rather
# than a silent fallback, because a container that ticks, claims rows, reports
# healthy, and never reaches a phone is the worst failure this system has.
#
# "telegram" delivers to a real device. Requires TELEGRAM_BOT_TOKEN and
# ALLOWED_SENDER_ID below, both of which the process refuses to boot without
# once this names them.
NOTIFY_TRANSPORT=logging

# Required only when NOTIFY_TRANSPORT=telegram; unset (or empty) then is a
# boot failure naming the missing variable, the same way NOTIFY_TRANSPORT
# itself is validated. Not required for the "logging" default, so `go run`
# with no bot still works.
#
# Token from @BotFather.
TELEGRAM_BOT_TOKEN=

# The numeric chat id this bot sends reminders to, and — since session 8 —
# the inbound sender allowlist (D8): anything not from this id is dropped
# silently. Required whenever either NOTIFY_TRANSPORT or CHAT_TRANSPORT names
# telegram, since a single-user system has one chat id for both directions.
# Get it from the chat with the bot once it exists.
ALLOWED_SENDER_ID=

# Which adapter receives conversation. Empty (the default here, same idea as
# NOTIFY_TRANSPORT=logging being the safe default above) means no inbound
# route exists at all — /webhook/telegram is never registered, and a POST
# there 404s from the mux itself. "telegram" requires TELEGRAM_WEBHOOK_SECRET
# and ALLOWED_SENDER_ID below; an unknown name is a boot failure, same
# reasoning as NOTIFY_TRANSPORT.
CHAT_TRANSPORT=

# Required only when CHAT_TRANSPORT=telegram. This is the whole
# authentication mechanism for /webhook/telegram (07-api-spec) — Telegram has
# no session to put behind Cloudflare Access, so this secret is the entire
# control. Set with Telegram's setWebhook (secret_token parameter); verified
# against the X-Telegram-Bot-Api-Secret-Token header on every request.
TELEGRAM_WEBHOOK_SECRET=

# Which upstream config/model.yaml's per-tier base_urls are expected to
# point at: "openrouter" (default, D-021 — one key, automatic provider
# failover) or "gemini" (every tier straight to Google's own
# OpenAI-compatible endpoint, right when every model in the routing table is
# already a Google model and OpenRouter's fan-out buys nothing). An unknown
# value fails the boot, same reasoning as NOTIFY_TRANSPORT. Flipping this
# without also editing config/model.yaml's base_urls to match fails the boot
# too, deliberately — see internal/model.ValidateProvider.
MODEL_PROVIDER=openrouter

# Required only when CHAT_TRANSPORT=telegram (session 11) and MODEL_PROVIDER
# is "openrouter" (the default): the conversation loop's model client reads
# it. Never required for the "logging" notify default or when CHAT_TRANSPORT
# is unset — required-when-consumed, same as TELEGRAM_WEBHOOK_SECRET above.
# One key against OpenRouter, which fronts every task's tiers.
OPENROUTER_API_KEY=

# Required only when CHAT_TRANSPORT=telegram and MODEL_PROVIDER=gemini.
# Same required-when-consumed shape as OPENROUTER_API_KEY above, just the
# other provider's key — from Google AI Studio, one key against
# generativelanguage.googleapis.com's OpenAI-compatible endpoint.
GOOGLE_API_KEY=

# Litestream (session 7) reads this straight from the container environment —
# it never reaches Go's config package, since litestream is a separate static
# binary wrapping navi as the container entrypoint. D4 is a Must with no
# honest default, so docker-compose.yml fails to boot the container when this
# is unset, the same way DEFAULT_TZ does.
#
# file:///backup/navi replicates to a local directory: no cloud account
# needed, right for local testing and for the restore drill in
# ops/restore-runbook.md. s3://<bucket>/navi is the real target — pair it with
# the three variables below since Cloudflare R2 needs a non-AWS endpoint that
# a bare s3:// URL cannot express.
LITESTREAM_REPLICA_URL=file:///backup/navi

# Required only when LITESTREAM_REPLICA_URL uses the s3:// scheme; ignored for
# file://. ENDPOINT is R2's account-specific host
# (https://<account_id>.r2.cloudflarestorage.com), not a plain AWS endpoint.
# LITESTREAM_ENDPOINT=
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=

# --- optional ---

# Local time of day the daily check-in goes out (K3), zero-padded HH:MM,
# defaulting to 21:00. Resolved against the device timezone (kv.current_tz,
# falling back to DEFAULT_TZ) rather than against any item's, because the
# check-in is one message to one person about their day.
#
# items.reconcile_at overrides it per item (K8), and an item with an earlier
# override gets its own pass at that time rather than waiting for this one —
# K4's one-message rule binds per pass, not per day. A malformed value ("9pm",
# "25:00") fails the boot rather than producing a check-in that never fires.
# RECONCILE_AT=21:00

# Writable directory on local disk holding the SQLite file, its WAL, and any
# secret generated on first run. Defaults to /data, which is what the compose
# volume mounts. Must not be an NFS or SMB mount: SQLite locking is unreliable
# there and a corrupted database is worse than any convenience gained (D3).
# DATA_DIR=/data

# Where the SQLite file lives. Defaults to navi.db under DATA_DIR, which is
# almost always what you want — set this only to put the database somewhere the
# rest of the data directory is not. docker-compose.yml sets this explicitly
# (rather than leaving it to the default) so litestream.yml can read the exact
# same path from the environment; change it in the compose file, not here, if
# you need a non-default layout in a container.
# DATABASE_PATH=/data/navi.db

# Directory holding the read-only configuration files: defaults.yaml now,
# persona.md from P5. Defaults to /config, which is where the compose file
# mounts ./config and where the image carries its own copies. Set it to ./config
# when running outside a container:
#
#   CONFIG_DIR=./config DEFAULT_TZ=America/Toronto DATA_DIR=./data go run ./cmd/navi
#
# CONFIG_DIR=/config
